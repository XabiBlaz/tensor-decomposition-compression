          },
          "quantization": {
            "enabled": false
          },
          "gated_mlp": {
            "methods": []
          }
        }
      },
      "benchmark": {
        "input_shape": [
          1,
          3,
          32,
          32
        ],
        "warmup": 3,
        "iterations": 20,
        "threads": 2
      }
    }
